---
import '../styles/global.css';

const services = [
  { number: '01', title: 'Launch systems', copy: 'A clear operating foundation for teams ready to move from ideas to repeatable growth.', tag: 'Strategy + setup' },
  { number: '02', title: 'Revenue design', copy: 'Sharper positioning, better journeys, and a sales system that makes momentum visible.', tag: 'Sales enablement' },
  { number: '03', title: 'Team velocity', copy: 'Practical workflows and tools that keep good work moving without adding process theatre.', tag: 'Operations' },
];

const plans = [
  { name: 'Focus', price: '$1,500', copy: 'For a focused launch or high-impact reset.', features: ['Positioning workshop', '90-day action map', 'Weekly advisory'] },
  { name: 'Momentum', price: '$3,900', copy: 'For teams building a repeatable growth engine.', features: ['Everything in Focus', 'Sales system design', 'Monthly leadership review'], featured: true },
  { name: 'Partner', price: 'Let’s talk', copy: 'For ambitious teams that want a steady strategic partner.', features: ['Embedded advisory', 'Quarterly planning', 'Priority access'] },
];

const faqs = [
  ['What kind of businesses do you work with?', 'We work with founder-led businesses and lean teams that have a strong offer but need a sharper path from potential to predictable growth.'],
  ['How quickly can we get started?', 'Most engagements begin with a focused working session within two weeks. We leave that session with priorities, owners, and a practical next step.'],
  ['Do you offer one-off projects?', 'Yes. Focus is designed as a contained project, while Momentum and Partner give teams ongoing support as the work compounds.'],
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Northstar helps ambitious businesses turn good ideas into durable growth systems." />
    <link rel="icon" href="/favicon.svg" />
    <title>Northstar | Make your next move count</title>
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b border-ink/10 bg-[#fbfcf9]/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10">
        <a href="#top" class="font-display text-xl font-bold tracking-tight">north<span class="text-teal">star</span><span class="text-teal">.</span></a>
        <nav class="hidden items-center gap-8 text-sm font-semibold text-ink/70 md:flex" aria-label="Main navigation">
          <a class="transition hover:text-teal" href="#services">What we do</a>
          <a class="transition hover:text-teal" href="#approach">Our approach</a>
          <a class="transition hover:text-teal" href="#plans">Ways to work</a>
          <a class="rounded-full bg-ink px-5 py-2.5 text-white transition hover:bg-teal" href="#contact">Start a conversation</a>
        </nav>
        <a class="rounded-full bg-ink px-4 py-2 text-sm font-semibold text-white md:hidden" href="#contact">Talk to us</a>
      </div>
    </header>

    <main id="top">
      <section class="relative overflow-hidden border-b border-ink/10">
        <div class="absolute inset-0 -z-10 grid-paper opacity-50"></div>
        <div class="mx-auto grid max-w-7xl gap-14 px-6 pb-20 pt-20 lg:grid-cols-[1.08fr_.92fr] lg:items-center lg:px-10 lg:pb-28 lg:pt-28">
          <div>
            <p class="mb-6 flex items-center gap-3 text-xs font-bold uppercase tracking-[.22em] text-teal"><span class="h-2 w-2 rounded-full bg-lime ring-4 ring-lime/30"></span>Business design studio</p>
            <h1 class="font-display text-balance max-w-3xl text-5xl font-bold leading-[.98] tracking-[-.04em] text-ink sm:text-7xl">Make your next move <span class="text-teal">count.</span></h1>
            <p class="mt-7 max-w-xl text-lg leading-8 text-ink/65">Northstar helps ambitious businesses turn good ideas into clear offers, confident sales, and systems built to last.</p>
            <div class="mt-9 flex flex-wrap items-center gap-4">
              <a class="rounded-full bg-teal px-6 py-3.5 font-semibold text-white shadow-lg shadow-teal/20 transition hover:-translate-y-0.5 hover:bg-ink" href="#contact">Find your next move <span aria-hidden="true">-&gt;</span></a>
              <a class="rounded-full border border-ink/20 px-6 py-3.5 font-semibold text-ink transition hover:border-teal hover:text-teal" href="#approach">See how we work</a>
            </div>
            <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-ink/15 pt-5 text-sm font-semibold text-ink/55"><span>Clarity before complexity</span><span>Practical by design</span><span>Built for momentum</span></div>
          </div>
          <div class="relative mx-auto w-full max-w-lg lg:ml-auto">
            <div class="absolute -right-8 -top-8 h-28 w-28 rounded-full bg-lime"></div>
            <div class="float-slow relative rounded-[2rem] bg-ink p-4 shadow-2xl shadow-ink/20 sm:p-6">
              <div class="rounded-[1.4rem] border border-white/10 bg-[#17363a] p-6 text-white sm:p-8">
                <div class="flex items-start justify-between"><div><p class="text-xs uppercase tracking-[.2em] text-lime">Northstar signal</p><p class="mt-2 font-display text-2xl font-bold">Momentum is a system.</p></div><span class="rounded-full bg-lime px-3 py-1 text-xs font-bold text-ink">Live</span></div>
                <div class="mt-12 flex items-end gap-2"><div class="h-12 w-8 rounded-t bg-teal/40"></div><div class="h-20 w-8 rounded-t bg-teal/60"></div><div class="h-28 w-8 rounded-t bg-teal"></div><div class="h-36 w-8 rounded-t bg-lime"></div><div class="h-44 w-8 rounded-t bg-white"></div></div>
                <div class="mt-5 flex justify-between border-t border-white/15 pt-4 text-xs text-white/55"><span>Today</span><span>Next quarter</span><span>Northstar plan</span></div>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-4"><div class="rounded-2xl bg-white/10 p-4 text-white"><p class="text-xs text-white/50">Clarity score</p><p class="mt-2 font-display text-3xl font-bold">94<span class="text-lime">%</span></p></div><div class="rounded-2xl bg-lime p-4 text-ink"><p class="text-xs text-ink/60">Next action</p><p class="mt-2 font-display text-lg font-bold">Defined.</p></div></div>
            </div>
          </div>
        </div>
      </section>

      <section id="services" class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="text-xs font-bold uppercase tracking-[.22em] text-teal">What we do</p><h2 class="font-display mt-4 text-4xl font-bold leading-tight tracking-[-.03em] sm:text-5xl">Less noise.<br /><span class="text-teal">More signal.</span></h2></div><div><p class="max-w-2xl text-xl leading-8 text-ink/65">You do not need another deck full of advice. You need the right decisions, made in the right order, with a team that helps make them real.</p><div class="mt-10 grid gap-4">{services.map((service) => <article class="group border-t border-ink/15 py-6 transition hover:border-teal"><div class="grid gap-4 sm:grid-cols-[4rem_1fr_auto] sm:items-start"><span class="font-display text-sm font-bold text-teal">{service.number}</span><div><h3 class="font-display text-2xl font-bold">{service.title}</h3><p class="mt-2 max-w-xl leading-7 text-ink/60">{service.copy}</p></div><span class="text-sm font-semibold text-ink/45 transition group-hover:text-teal">{service.tag}</span></div></article>)}</div></div></div>
      </section>

      <section id="approach" class="bg-ink text-white"><div class="mx-auto grid max-w-7xl gap-16 px-6 py-24 lg:grid-cols-[.8fr_1.2fr] lg:px-10 lg:py-32"><div><p class="text-xs font-bold uppercase tracking-[.22em] text-lime">Our approach</p><h2 class="font-display mt-4 text-4xl font-bold leading-tight tracking-[-.03em] sm:text-5xl">A clear path is a competitive advantage.</h2></div><div class="grid gap-10 sm:grid-cols-3"><div><p class="font-display text-5xl font-bold text-lime">01</p><h3 class="mt-5 font-display text-xl font-bold">See clearly</h3><p class="mt-3 leading-7 text-white/55">We surface the real constraint, not just the loudest symptom.</p></div><div><p class="font-display text-5xl font-bold text-lime">02</p><h3 class="mt-5 font-display text-xl font-bold">Choose bravely</h3><p class="mt-3 leading-7 text-white/55">We turn insight into a few high-conviction priorities.</p></div><div><p class="font-display text-5xl font-bold text-lime">03</p><h3 class="mt-5 font-display text-xl font-bold">Move together</h3><p class="mt-3 leading-7 text-white/55">We stay close enough to help the plan survive contact with reality.</p></div></div></div></section>

      <section id="plans" class="bg-mist px-6 py-24 lg:px-10 lg:py-32"><div class="mx-auto max-w-7xl"><div class="flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="text-xs font-bold uppercase tracking-[.22em] text-teal">Ways to work</p><h2 class="font-display mt-4 text-4xl font-bold tracking-[-.03em] sm:text-5xl">Choose your level of momentum.</h2></div><p class="max-w-sm text-ink/60">Start with the shape of help you need now. Scale the relationship as the opportunity grows.</p></div><div class="mt-12 grid gap-5 lg:grid-cols-3">{plans.map((plan) => <article class:list={["relative flex flex-col rounded-3xl border p-7", plan.featured ? "border-teal bg-ink text-white shadow-xl shadow-ink/15" : "border-ink/10 bg-white"]}>{plan.featured && <span class="absolute right-6 top-6 rounded-full bg-lime px-3 py-1 text-xs font-bold text-ink">Most popular</span>}<h3 class="font-display text-2xl font-bold">{plan.name}</h3><p class:list={["mt-3 min-h-14 leading-6", plan.featured ? "text-white/60" : "text-ink/60"]}>{plan.copy}</p><p class="font-display mt-8 text-3xl font-bold">{plan.price}{plan.price.startsWith('$') && <span class="font-sans text-sm font-normal opacity-50"> / project</span>}</p><ul class:list={["mt-7 space-y-3 border-t pt-6 text-sm", plan.featured ? "border-white/15 text-white/75" : "border-ink/10 text-ink/65"]}>{plan.features.map((feature) => <li><span class="mr-2 text-teal">+</span>{feature}</li>)}</ul><a class:list={["mt-8 rounded-full px-5 py-3 text-center font-semibold transition", plan.featured ? "bg-lime text-ink hover:bg-white" : "bg-ink text-white hover:bg-teal"]} href="#contact">Explore {plan.name}</a></article>)}</div></div></section>

      <section class="mx-auto max-w-3xl px-6 py-24 lg:py-32"><p class="text-center text-xs font-bold uppercase tracking-[.22em] text-teal">A few answers</p><h2 class="font-display mt-4 text-center text-4xl font-bold tracking-[-.03em]">Good questions lead to better work.</h2><div class="mt-10 space-y-3">{faqs.map(([question, answer]) => <details class="group rounded-2xl border border-ink/10 bg-white px-6 py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-display font-bold">{question}<span class="text-2xl font-normal text-teal transition group-open:rotate-45">+</span></summary><p class="max-w-2xl pt-4 leading-7 text-ink/60">{answer}</p></details>)}</div></section>

      <section id="contact" class="px-6 pb-24 lg:px-10 lg:pb-32"><div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-teal px-7 py-12 text-white sm:px-12 lg:px-16 lg:py-16"><div class="grid gap-12 lg:grid-cols-[1fr_.8fr] lg:items-end"><div><p class="text-xs font-bold uppercase tracking-[.22em] text-lime">Start a conversation</p><h2 class="font-display mt-4 max-w-2xl text-4xl font-bold leading-tight tracking-[-.03em] sm:text-6xl">Your next move is closer than it looks.</h2><p class="mt-6 max-w-xl text-lg leading-8 text-white/70">Tell us where you are stuck, what you are building, or what needs to change. We will reply with a useful next step.</p></div><form class="space-y-4" name="contact" method="POST" data-netlify="true"><input type="hidden" name="form-name" value="contact" /><label class="sr-only" for="name">Name</label><input class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-white outline-none placeholder:text-white/50 focus:border-lime" id="name" name="name" placeholder="Your name" required /><label class="sr-only" for="email">Email</label><input class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-white outline-none placeholder:text-white/50 focus:border-lime" id="email" name="email" type="email" placeholder="Work email" required /><label class="sr-only" for="message">What can we help with?</label><textarea class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-white outline-none placeholder:text-white/50 focus:border-lime" id="message" name="message" rows="4" placeholder="What can we help with?" required></textarea><button class="w-full rounded-xl bg-lime px-5 py-3.5 font-semibold text-ink transition hover:bg-white" type="submit">Send the note <span aria-hidden="true">-&gt;</span></button></form></div></div></section>
    </main>

    <footer class="border-t border-ink/10 px-6 py-8 lg:px-10"><div class="mx-auto flex max-w-7xl flex-col justify-between gap-3 text-sm text-ink/50 sm:flex-row"><span class="font-display font-bold text-ink">north<span class="text-teal">star</span><span class="text-teal">.</span></span><span>Business design for teams going somewhere.</span><span>© 2026 Northstar</span></div></footer>
  </body>
</html>
