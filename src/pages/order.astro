---
import '../styles/global.css';
import OrderCheckout from '../components/OrderCheckout';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Review Order | Northstar</title>
  </head>
  <body class="bg-[#f3f7ff] text-ink">
    <main class="mx-auto max-w-5xl px-6 py-12 lg:px-10 lg:py-16">
      <div class="flex items-center justify-between gap-4">
        <a href="/" class="font-display text-xl font-bold tracking-tight">e<span class="text-teal">Publishing</span><span class="text-teal">.</span></a>
        <a href="/" class="text-sm font-semibold text-teal hover:text-ink">Back to products</a>
      </div>

      <section class="mt-10">
        <p class="text-xs font-bold uppercase tracking-[.2em] text-teal">Order cart</p>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-[-.04em] sm:text-5xl">Review and place your order</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-ink/60">Check your selected products, register your email, and choose a payment method.</p>
      </section>

      <div class="mt-10 grid gap-8 lg:grid-cols-[.9fr_1.1fr]">
        <section class="rounded-3xl border border-ink/10 bg-white p-6 shadow-sm lg:p-8" aria-labelledby="selected-products-title">
          <div class="flex items-center justify-between gap-4">
            <h2 id="selected-products-title" class="font-display text-2xl font-bold">Selected products</h2>
            <span class="text-sm text-ink/55">Review</span>
          </div>
          <p data-order-empty class="mt-8 rounded-2xl bg-[#edf4ff] p-5 text-sm leading-6 text-ink/65">Your order is empty. Choose a product plan to continue.</p>
          <ul data-order-items class="mt-4"></ul>
          <div class="mt-6 flex items-center justify-between border-t border-ink/10 pt-5 text-lg font-bold">
            <span>Total</span>
            <span class="text-teal" data-order-total>$0</span>
          </div>
        </section>

        <section class="rounded-3xl border border-ink/10 bg-white p-6 shadow-sm lg:p-8">
          <h2 class="font-display text-2xl font-bold">Customer and payment</h2>
          <OrderCheckout client:load />
        </section>
      </div>
    </main>
  </body>
</html>
<script src="../scripts/order.ts"></script>