---
import { readdirSync, readFileSync } from 'fs';
import { join } from 'path';
import { fileURLToPath } from 'url';
import '../../styles/global.css';

const mobileFolder = fileURLToPath(new URL('../../../products/mobile/', import.meta.url));
const mobileProducts = readdirSync(mobileFolder, { withFileTypes: true })
  .filter((entry) => entry.isDirectory())
  .map((entry) => {
    const rows = readFileSync(join(mobileFolder, entry.name, 'simple.txt'), 'utf8')
      .split(/\r?\n/)
      .map((feature) => feature.trim())
      .filter(Boolean);

    return {
      name: entry.name.replace(/[-_]+/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()),
      features: rows.slice(0, -2),
      cost: rows.at(-2)?.replace(/^Cost\s+/i, '') ?? '',
    };
  });
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mobile App | Northstar</title>
  </head>
  <body class="bg-[#effaf5] text-ink">
    <main class="mx-auto max-w-5xl px-6 py-16 lg:px-10">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:text-ink">← Back to home</a>

      <section class="mt-10 overflow-hidden rounded-[2rem] border border-emerald-900/10 bg-white shadow-xl shadow-emerald-900/5">
        <div class="bg-[#123b35] px-8 py-10 text-white lg:px-12">
          <p class="text-xs font-bold uppercase tracking-[.2em] text-emerald-300">Always in your pocket</p>
          <h1 class="mt-4 font-display text-4xl font-bold tracking-[-.04em] sm:text-6xl">Mobile App</h1>
        </div>

        <div class="px-8 py-10 lg:px-12">
          <div>
            <p class="text-lg leading-8 text-ink/70">Drive real-time engagement with a mobile product that feels intuitive, useful, and ready for action.</p>
            <p class="mt-6 text-base leading-8 text-ink/60">Built for speed and convenience, the mobile app keeps your product within reach and your customers connected to the moments that matter most.</p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a class="rounded-full bg-emerald-600 px-6 py-3 font-semibold text-white transition hover:bg-emerald-800" href="#contact">Try the mobile app</a>
              <a class="rounded-full border border-ink/15 px-6 py-3 font-semibold text-ink transition hover:border-emerald-600 hover:text-emerald-700" href="/">View all products</a>
            </div>
          </div>

          <div class="mt-12">
            <p class="text-xs font-bold uppercase tracking-[.2em] text-emerald-700">Mobile products</p>
            <div class="mt-5 grid gap-5 lg:grid-cols-3">
              {mobileProducts.map((product) => (
                <article class="cursor-pointer rounded-2xl border border-emerald-900/10 border-t-2 bg-[#e4f6ed] p-5 transition duration-200 hover:-translate-y-1 hover:border-emerald-900/10 hover:border-t-emerald-500 hover:shadow-lg focus-within:ring-2 focus-within:ring-emerald-500/40">
                  <div class="flex items-center justify-between gap-3">
                    <h2 class="font-display text-xl font-bold text-ink">{product.name}</h2>
                    <span class="text-sm font-semibold text-emerald-700">{product.cost}</span>
                  </div>
                  <ul class="mt-4 space-y-2 text-sm text-ink/75">
                    {product.features.map((feature) => (
                      <li class="flex items-start gap-3 rounded-lg bg-white/75 px-3 py-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-emerald-600"></span><span>{feature}</span></li>
                    ))}
                  </ul>
                  <button class="mt-5 w-full rounded-xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-emerald-800" type="button" data-add-to-cart data-product={product.name} data-plan="Basic" data-cost={product.cost}>Add to order</button>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
<script src="../../scripts/cart.ts"></script>
