---
import { readFileSync } from 'fs';
import { fileURLToPath } from 'url';
import '../../styles/global.css';

const tierDefinitions = [
  { name: 'Basic', file: 'simple.txt', label: 'Starter', description: 'For straightforward daily operations' },
  { name: 'Medium', file: 'medium.txt', label: 'Popular', description: 'For growing teams and locations' },
  { name: 'Complex', file: 'complex.txt', label: 'Custom', description: 'For specialist and enterprise systems' },
];

const webFolder = fileURLToPath(new URL('../../../products/web/', import.meta.url));
const tiers = tierDefinitions.map((tier) => {
  const rows = readFileSync(`${webFolder}${tier.file}`, 'utf8')
    .split(/\r?\n/)
    .map((feature) => feature.trim())
    .filter(Boolean);

  return {
    ...tier,
    features: rows.slice(0, -2),
    cost: rows.at(-2)?.replace(/^Cost\s+/i, '') ?? '',
    renewalCost: rows.at(-1)?.replace(/^Renewal cost\s+/i, '') ?? '',
  };
});
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Web App | Northstar</title>
  </head>
  <body class="bg-[#fffaf3] text-ink">
    <main class="mx-auto max-w-5xl px-6 py-16 lg:px-10">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-teal hover:text-ink">← Back to home</a>

      <section class="mt-10 overflow-hidden rounded-[2rem] border border-ink/10 bg-white shadow-xl shadow-ink/5">
        <div class="bg-[#0b1220] px-8 py-10 text-white lg:px-12">
          <p class="text-xs font-bold uppercase tracking-[.2em] text-lime">Fast access from anywhere</p>
          <h1 class="mt-4 font-display text-4xl font-bold tracking-[-.04em] sm:text-6xl">Web App</h1>
        </div>

        <div class="px-8 py-10 lg:px-12">
          <div>
            <p class="text-lg leading-8 text-ink/70">A flexible web experience for customers, staff, and stakeholders who need power without friction.</p>
            <p class="mt-6 text-base leading-8 text-ink/60">The web app is designed for everyday momentum — fast onboarding, simple collaboration, and a clean experience across every browser.</p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a class="rounded-full bg-teal px-6 py-3 font-semibold text-white transition hover:bg-ink" href="#contact">Explore the web app</a>
              <a class="rounded-full border border-ink/15 px-6 py-3 font-semibold text-ink transition hover:border-teal hover:text-teal" href="/">View all products</a>
            </div>
          </div>

          <div class="mt-12">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-[.2em] text-teal">Choose your build</p>
                <h2 class="mt-2 font-display text-3xl font-bold tracking-tight">Web application</h2>
              </div>
              <p class="max-w-sm text-sm leading-6 text-ink/60">Select the feature depth that matches your web application workflow.</p>
            </div>

            <div class="mt-6 grid gap-5 lg:grid-cols-3">
              {tiers.map((tier) => (
                <article class:list={[
                  'flex cursor-pointer flex-col rounded-2xl border-2 border-transparent border-t-4 border-t-ink/10 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-transparent hover:border-t-teal hover:shadow-lg focus-within:ring-2 focus-within:ring-teal/40',
                  tier.name === 'Medium' ? 'border-teal border-t-teal' : '',
                ]}>
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="font-display text-2xl font-bold">{tier.name}</h3>
                      <p class="mt-1 text-sm text-ink/60">{tier.description}</p>
                    </div>
                    <span class:list={[
                      'rounded-full px-3 py-1 text-xs font-bold',
                      tier.name === 'Medium' ? 'bg-teal text-white' : 'bg-[#fff0df] text-teal',
                    ]}>{tier.label}</span>
                  </div>
                  <ul class="mt-6 flex-1 space-y-3 text-sm text-ink/75">
                    {tier.features.map((feature) => (
                      <li class="flex items-start gap-3"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-teal"></span><span>{feature}</span></li>
                    ))}
                  </ul>
                  <div class="mt-5 border-t border-ink/10 pt-4 text-sm">
                    <div class="flex items-center justify-between"><span class="text-ink/60">Cost</span><strong>{tier.cost}</strong></div>
                    <div class="mt-2 flex items-center justify-between"><span class="text-ink/60">Renewal cost</span><strong>{tier.renewalCost}</strong></div>
                  </div>
                  <button class="mt-5 w-full rounded-xl bg-teal px-4 py-3 text-sm font-semibold text-white transition hover:bg-ink" type="button" data-add-to-cart data-product="Web application" data-plan={tier.name} data-cost={tier.cost} data-renewal-cost={tier.renewalCost}>Add to order</button>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
<script src="../../scripts/cart.ts"></script>
