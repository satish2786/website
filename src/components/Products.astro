---
import { readdirSync } from 'fs';
import { fileURLToPath } from 'url';

const appDetails: Record<string, { tagline: string; intro: string; highlight: string }> = {
  desktop: {
    tagline: 'Built for power users',
    intro: 'Streamline your workflow with a fast, focused desktop experience designed for teams that work at speed.',
    highlight: 'Optimized for performance and precision.',
  },
  web: {
    tagline: 'Fast access from anywhere',
    intro: 'Give customers and teams a seamless browser experience with flexible tools, secure access, and effortless collaboration.',
    highlight: 'Designed for scale, clarity, and daily use.',
  },
  mobile: {
    tagline: 'Always in your pocket',
    intro: 'Keep your product close to customers with a mobile experience that is intuitive, responsive, and built for action.',
    highlight: 'Built for engagement, speed, and convenience.',
  },
};

const productsFolder = fileURLToPath(new URL('../../products/', import.meta.url));
const products = readdirSync(productsFolder, { withFileTypes: true })
  .filter((entry) => entry.isDirectory() && entry.name in appDetails)
  .map((entry) => ({
    slug: `${entry.name}-app`,
    name: `${entry.name} app`.replace(/\b\w/g, (letter) => letter.toUpperCase()),
    ...appDetails[entry.name],
  }));
---

<section id="products" class="bg-indigo-50/70 px-6 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[.22em] text-indigo-700">Products</p>
      <h2 class="mt-4 font-display text-4xl font-bold tracking-[-.03em] text-ink sm:text-5xl">Built for every way your customers work.</h2>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {products.map((product) => (
        <a href={`/products/${product.slug}`} class="group flex h-full flex-col rounded-[1.8rem] border border-indigo-100 bg-white p-7 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-indigo-400 hover:shadow-xl hover:shadow-indigo-500/10">
          <div class="flex items-center justify-between">
            <span class="rounded-full bg-indigo-100 px-3 py-1 text-xs font-bold uppercase tracking-[.14em] text-indigo-700">{product.tagline}</span>
            <span class="text-xl text-indigo-600 transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </div>

          <div class="mt-8">
            <h3 class="font-display text-3xl font-bold text-ink">{product.name}</h3>
            <p class="mt-4 text-base leading-7 text-ink/65">{product.intro}</p>
          </div>

          <div class="mt-8 rounded-2xl bg-[#0b1220] p-4 text-sm text-white/80">
            <p class="font-semibold text-white">Why it stands out</p>
            <p class="mt-2 leading-6 text-white/70">{product.highlight}</p>
          </div>

          <div class="mt-8 flex items-center justify-between border-t border-ink/10 pt-5 text-sm font-semibold text-ink/70">
            <span>Explore product</span>
            <span class="text-indigo-600">Learn more</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
