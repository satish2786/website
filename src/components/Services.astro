---
const services = [
  { number: '01', title: 'Google Workspace', copy: 'Smart collaboration tools, secure productivity, and streamlined communication for modern teams.', tag: 'Workspace services' },
  { number: '02', title: 'Microsoft 365', copy: 'Comprehensive productivity solutions with email, collaboration, security, and business continuity built in.', tag: 'Microsoft services' },
  { number: '03', title: 'Azure', copy: 'Scalable cloud infrastructure, app hosting, and enterprise-grade security designed for business growth.', tag: 'Cloud platform' },
  { number: '04', title: 'AWS', copy: 'Flexible, reliable cloud services that help businesses deploy, scale, and optimize digital operations.', tag: 'Cloud platform' },
];
---

<section id="services" class="bg-emerald-50/60 px-6 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-7xl">
  <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
    <div>
      <p class="text-xs font-bold uppercase tracking-[.22em] text-emerald-700">Services</p>
      <h2 class="font-display mt-4 text-4xl font-bold leading-tight tracking-[-.03em] sm:text-5xl">Technology services built for <span class="text-emerald-700">business momentum.</span></h2>
    </div>
    <div>
      <p class="max-w-2xl text-xl leading-8 text-ink/65">We help businesses simplify their digital stack with secure, scalable tools and cloud solutions that keep teams connected and productive.</p>
      <div class="mt-10 grid gap-4">
        {services.map((service) => (
          <article class="group border-t border-emerald-200 py-6 transition hover:border-emerald-600">
            <div class="grid gap-4 sm:grid-cols-[4rem_1fr_auto] sm:items-start">
              <span class="font-display text-sm font-bold text-emerald-700">{service.number}</span>
              <div>
                <h3 class="font-display text-2xl font-bold">{service.title}</h3>
                <p class="mt-2 max-w-xl leading-7 text-ink/60">{service.copy}</p>
              </div>
              <span class="text-sm font-semibold text-ink/45 transition group-hover:text-emerald-700">{service.tag}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
    </div>
  </div>
</section>
