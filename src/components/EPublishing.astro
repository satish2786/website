---
const publishingServices = [
  {
    name: 'OCR Extraction',
    description: 'Accurately capture text from scanned documents, PDFs, and images so your content can be repurposed quickly and reliably.'
  },
  {
    name: 'Data Conversion',
    description: 'Transform document data into structured, usable formats for easier storage, processing, and downstream automation.'
  },
  {
    name: 'ePub Creation',
    description: 'Design and produce polished digital publications optimized for modern reading devices and long-form content delivery.'
  },
];
---

<section id="epublishing" class="bg-amber-50/70 px-6 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[.22em] text-amber-700">ePublishing</p>
      <h2 class="mt-4 font-display text-4xl font-bold tracking-[-.03em] text-ink sm:text-5xl">Digital publishing services built for content conversion and delivery.</h2>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {publishingServices.map((service) => (
        <article class="flex h-full flex-col rounded-[1.8rem] border border-amber-100 bg-white/80 p-7 shadow-sm transition hover:-translate-y-1 hover:border-amber-400 hover:shadow-xl hover:shadow-amber-500/10">
          <div class="flex items-center justify-between">
            <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold uppercase tracking-[.14em] text-amber-700">Solution</span>
            <span class="text-xl text-amber-600" aria-hidden="true">→</span>
          </div>

          <h3 class="mt-8 font-display text-3xl font-bold text-ink">{service.name}</h3>
          <p class="mt-4 text-base leading-7 text-ink/65">{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
