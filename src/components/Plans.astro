---
const plans = [
  { name: 'Focus', price: '$1,500', copy: 'For a focused launch or high-impact reset.', features: ['Positioning workshop', '90-day action map', 'Weekly advisory'] },
  { name: 'Momentum', price: '$3,900', copy: 'For teams building a repeatable growth engine.', features: ['Everything in Focus', 'Sales system design', 'Monthly leadership review'], featured: true },
  { name: 'Partner', price: 'Let’s talk', copy: 'For ambitious teams that want a steady strategic partner.', features: ['Embedded advisory', 'Quarterly planning', 'Priority access'] },
];
---

<section id="plans" class="bg-violet-50/60 px-6 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.22em] text-violet-700">Ways to work</p>
        <h2 class="font-display mt-4 text-4xl font-bold tracking-[-.03em] sm:text-5xl">Choose your level of momentum.</h2>
      </div>
      <p class="max-w-sm text-ink/60">Start with the shape of help you need now. Scale the relationship as the opportunity grows.</p>
    </div>
    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {plans.map((plan) => (
        <article class:list={["relative flex flex-col rounded-3xl border p-7", plan.featured ? "border-teal bg-ink text-white shadow-xl shadow-ink/15" : "border-ink/10 bg-white"]}>
          {plan.featured && <span class="absolute right-6 top-6 rounded-full bg-lime px-3 py-1 text-xs font-bold text-ink">Most popular</span>}
          <h3 class="pr-24 font-display text-2xl font-bold sm:pr-0">{plan.name}</h3>
          <p class:list={["mt-3 min-h-14 leading-6", plan.featured ? "text-white/60" : "text-ink/60"]}>{plan.copy}</p>
          <p class="font-display mt-8 text-3xl font-bold">{plan.price}{plan.price.startsWith('$') && <span class="font-sans text-sm font-normal opacity-50"> / project</span>}</p>
          <ul class:list={["mt-7 space-y-3 border-t pt-6 text-sm", plan.featured ? "border-white/15 text-white/75" : "border-ink/10 text-ink/65"]}>
            {plan.features.map((feature) => <li><span class="mr-2 text-violet-600">+</span>{feature}</li>)}
          </ul>
          <a class:list={["mt-8 rounded-full px-5 py-3 text-center font-semibold transition", plan.featured ? "bg-lime text-ink hover:bg-white" : "bg-ink text-white hover:bg-violet-600"]} href="#contact">Explore {plan.name}</a>
        </article>
      ))}
    </div>
  </div>
</section>
